# ==================== 名人图片 (100x100) ====================
def create_person_thumb(filename, name, color1="#6B3A2A", color2="#8B5A3C"):
    """名人缩略图"""
    w, h = 100, 100
    img = make_gradient(w, h, color1, color2, vertical=True)
    draw = ImageDraw.Draw(img, 'RGBA')

    font = get_font(16, bold=True)
    if len(name) <= 3:
        # 竖向排列
        for i, ch in enumerate(name):
            draw_centered_text(draw, ch, 10 + i * 30, w, get_font(18, bold=True), C_GOLD)
    else:
        draw_centered_text(draw, name[:2], 28, w, font, C_GOLD)
        draw_centered_text(draw, name[2:], 52, w, font, C_GOLD)

    img.save(os.path.join(IMG_DIR, filename), quality=85)
    print(f"✓ {filename}")


