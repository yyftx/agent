import tkinter as tk
import random

# 初始化窗口
root = tk.Tk()
root.title("像素流泪猫咪 😿")
canvas = tk.Canvas(root, width=300, height=400, bg="black")
canvas.pack()

tears = []  # 存储眼泪坐标

def draw_cat():
    """绘制像素风猫咪"""
    x, y = 80, 100
    # 左耳
    canvas.create_rectangle(x + 15, y + 5, x + 35, y + 25, fill="#D2B48C", outline="")
    # 右耳
    canvas.create_rectangle(x + 65, y + 5, x + 85, y + 25, fill="#D2B48C", outline="")
    # 头部
    canvas.create_rectangle(x + 25, y, x + 75, y + 40, fill="#D2B48C", outline="")
    # 左眼
    canvas.create_oval(x + 40, y + 18, x + 50, y + 28, fill="#00BFFF", outline="")
    # 右眼
    canvas.create_oval(x + 60, y + 18, x + 70, y + 28, fill="#00BFFF", outline="")
    # 鼻子
    canvas.create_oval(x + 53, y + 30, x + 63, y + 36, fill="#A0522D", outline="")
    # 身体
    canvas.create_rectangle(x + 25, y + 40, x + 75, y + 100, fill="#D2B48C", outline="")
    # 尾巴
    canvas.create_rectangle(x + 75, y + 65, x + 95, y + 75, fill="#A0522D", outline="")

def add_tear():
    """随机从眼睛下方生成泪滴"""
    tears.append([130 + random.randint(-20, 20), 125])

def add_click_tear(event):
    """点击位置生成泪滴"""
    tears.append([event.x, event.y])

def animate():
    """动画循环：绘制泪滴并下落"""
    canvas.delete("tear")  # 清除上一帧的泪滴
    new_tears = []
    for tx, ty in tears:
        ty += 2  # 下落速度
        if ty < 400:
            canvas.create_oval(tx - 2, ty - 2, tx + 2, ty + 2, fill="#00BFFF", outline="", tags="tear")
            new_tears.append([tx, ty])
    tears.clear()
    tears.extend(new_tears)

    # 随机自然流泪
    if random.random() < 0.06:
        add_tear()

    root.after(16, animate)  # 约60帧/秒

# 绑定点击事件
canvas.bind("<Button-1>", add_click_tear)

# 启动
draw_cat()
animate()
root.mainloop()
