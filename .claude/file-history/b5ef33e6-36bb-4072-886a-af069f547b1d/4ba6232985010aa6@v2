class WebIDE(http.server.BaseHTTPRequestHandler):
    def log_message(self, format, *args):
        pass  # 关闭请求日志

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        params = urllib.parse.parse_qs(parsed.query)

        if path == '/' or path == '/index.html':
            self._send_html(HTML)
        elif path == '/api/files':
            self._handle_list_files(params.get('path', [''])[0])
        elif path == '/api/file':
            self._handle_read_file(params.get('path', [''])[0])
        else:
            # 尝试作为静态文件提供
            self._serve_static(self.path)

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        params = urllib.parse.parse_qs(parsed.query)

        if path == '/api/file':
            content_length = int(self.headers.get('Content-Length', 0))
            content = self.rfile.read(content_length).decode('utf-8')
            self._handle_write_file(params.get('path', [''])[0], content)
        elif path == '/api/terminal':
            content_length = int(self.headers.get('Content-Length', 0))
            body = json.loads(self.rfile.read(content_length).decode('utf-8'))
            self._handle_terminal(body.get('cmd', ''), body.get('cwd', '.'))

    def _send_html(self, html):
        self.send_response(200)
        self.send_header('Content-Type', 'text/html; charset=utf-8')
        self.end_headers()
        self.wfile.write(html.encode('utf-8'))

    def _send_json(self, data):
        self.send_response(200)
        self.send_header('Content-Type', 'application/json; charset=utf-8')
        self.send_header('Access-Control-Allow-Origin', '*')
        self.end_headers()
        self.wfile.write(json.dumps(data, ensure_ascii=False).encode('utf-8'))

    def _safe_path(self, rel_path):
        """防止目录遍历攻击"""
        abs_path = os.path.normpath(os.path.join(ROOT, rel_path))
        if not abs_path.startswith(os.path.normpath(ROOT)):
            return None
        return abs_path

    def _handle_list_files(self, dir_path):
        abs_path = self._safe_path(dir_path)
        if abs_path is None or not os.path.isdir(abs_path):
            self._send_json([])
            return
        items = []
        try:
            # 过滤隐藏文件和 node_modules
            for name in sorted(os.listdir(abs_path)):
                if name.startswith('.') and name != '.gitignore':
                    continue
                if name in ['node_modules', '__pycache__', '.git']:
                    continue
                full = os.path.join(abs_path, name)
                rel = os.path.relpath(full, ROOT).replace('\\', '/')
                items.append({
                    'name': name,
                    'path': rel,
                    'type': 'dir' if os.path.isdir(full) else 'file'
                })
        except PermissionError:
            pass
        self._send_json(items)

    def _handle_read_file(self, file_path):
        abs_path = self._safe_path(file_path)
        if abs_path is None or not os.path.isfile(abs_path):
            self._send_json({'error': 'File not found', 'content': ''})
            return
        try:
            with open(abs_path, 'r', encoding='utf-8') as f:
                content = f.read()
        except (UnicodeDecodeError, PermissionError):
            content = '[无法读取此文件（二进制或权限不足）]'
        self._send_json({'content': content, 'path': file_path})

    def _handle_write_file(self, file_path, content):
        abs_path = self._safe_path(file_path)
        if abs_path is None:
            self._send_json({'error': 'Invalid path'})
            return
        try:
            os.makedirs(os.path.dirname(abs_path), exist_ok=True)
            with open(abs_path, 'w', encoding='utf-8') as f:
                f.write(content)
            self._send_json({'success': True})
        except Exception as e:
            self._send_json({'error': str(e)})

    def _handle_terminal(self, cmd, cwd):
        if not cmd:
            self._send_json({'output': '', 'error': ''})
            return
        abs_cwd = self._safe_path(cwd) or ROOT
        try:
            result = subprocess.run(
                ['powershell', '-NoProfile', '-Command', cmd],
                capture_output=True, text=True, timeout=30,
                cwd=abs_cwd, encoding='gbk', errors='replace'
            )
            output = result.stdout
            error = result.stderr
            if result.returncode != 0 and not error:
                error = f'\n[退出码: {result.returncode}]'
            self._send_json({'output': output, 'error': error})
        except subprocess.TimeoutExpired:
            self._send_json({'output': '', 'error': '\n[命令超时]'})
        except Exception as e:
            self._send_json({'output': '', 'error': f'\n[错误: {e}]'})

    def _serve_static(self, file_path):
        """提供静态文件（用于项目中的图片等）"""
        abs_path = self._safe_path(file_path.lstrip('/'))
        if abs_path and os.path.isfile(abs_path):
            ext = os.path.splitext(abs_path)[1].lower()
            mime_map = {
                '.png': 'image/png', '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg',
                '.gif': 'image/gif', '.svg': 'image/svg+xml', '.ico': 'image/x-icon',
                '.css': 'text/css', '.js': 'application/javascript',
                '.woff2': 'font/woff2', '.ttf': 'font/ttf'
            }
            try:
                with open(abs_path, 'rb') as f:
                    content = f.read()
                self.send_response(200)
                self.send_header('Content-Type', mime_map.get(ext, 'application/octet-stream'))
                self.end_headers()
                self.wfile.write(content)
            except Exception:
                self.send_response(404)
                self.end_headers()
        else:
            self.send_response(404)
            self.end_headers()


